node_modules/
.next/
.env*
*.log
.DS_Store

# Generated by `pnpm generate-search-index` (predev / prebuild). Never commit.
public/search-index.json

# Generated by `pnpm generate-versions` (prebuild): the latest release tags the
# build resolved. Regenerated per build, so committing it would only add churn
# and a stale copy the client hook might trust.
public/versions.json

# pnpm's project-local content-addressable store (this machine's store-dir
# resolves to a relative path). node_modules hardlinks from it, so it stays on
# disk — it just never belongs in git.
.pnpm-store/

*.tsbuildinfo
